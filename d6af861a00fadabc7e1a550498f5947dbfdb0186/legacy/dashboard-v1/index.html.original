<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Trade Bot — Live</title>
<script>window.DATA_URL='https://raw.githubusercontent.com/Arxhsz/trade-bot-dashboard/data/data.json'</script><script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
<style>
:root{--bg:#0b0f14;--card:#121821;--line:#1f2a36;--mut:#8a97a8;--txt:#e6edf3;--g:#22c55e;--r:#ef4444;--y:#eab308;--b:#38bdf8}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--txt);font:14px/1.4 -apple-system,Segoe UI,Roboto,sans-serif}
.wrap{max-width:1100px;margin:auto;padding:12px}header{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
h1{font-size:18px;margin:4px 0}.mut{color:var(--mut)}.g{color:var(--g)}.r{color:var(--r)}.y{color:var(--y)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin:10px 0}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px}
.k{font-size:12px;color:var(--mut);text-transform:uppercase;letter-spacing:.04em}.v{font-size:22px;font-weight:700;margin-top:2px}
.pill{display:inline-block;padding:3px 10px;border-radius:99px;font-weight:600;font-size:12px}
.pg{background:#14532d;color:#86efac}.pr{background:#7f1d1d;color:#fecaca}.py{background:#713f12;color:#fde68a}
.cols{display:grid;grid-template-columns:1.4fr 1fr;gap:10px}@media(max-width:820px){.cols{grid-template-columns:1fr}}
.coin{font-size:28px;font-weight:800}a{color:var(--b);text-decoration:none}
table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:7px 6px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}
th{color:var(--mut);font-weight:500}.tw{overflow-x:auto}
#chart{height:300px;margin-top:8px}.feed{max-height:560px;overflow-y:auto}.ev{padding:6px 0;border-bottom:1px solid var(--line);font-size:13px}
.ev .t{color:var(--mut);font-size:11px;margin-right:6px}.kb{color:var(--g);font-weight:700}.ks{color:var(--y);font-weight:700}.kh{color:var(--r);font-weight:700}
.row{display:flex;gap:16px;flex-wrap:wrap;margin-top:6px}.row div{min-width:110px}
</style></head><body><div class="wrap">
<header><div><h1>🤖 Trade Bot — Live Dashboard</h1><div class="mut" id="sub">loading…</div></div><div id="statuspill"></div></header>
<div class="grid">
 <div class="card"><div class="k">Total value</div><div class="v" id="total">—</div><div class="mut" id="totsol"></div></div>
 <div class="card"><div class="k">Today P&amp;L</div><div class="v" id="pnl">—</div><div class="mut" id="pnlsub"></div></div>
 <div class="card"><div class="k">Wallet SOL</div><div class="v" id="wal">—</div><div class="mut" id="dep"></div></div>
 <div class="card"><div class="k">Trades today</div><div class="v" id="tc">—</div><div class="mut" id="wl"></div></div>
</div>
<div class="cols">
 <div>
  <div class="card" id="openc"></div>
  <div class="card" style="margin-top:10px"><div class="k">Past trades today</div><div class="tw"><table><thead><tr><th>Time ET</th><th>Coin</th><th>Buy</th><th>Sell</th><th>P&amp;L</th><th>Hold</th><th>Tx</th></tr></thead><tbody id="tr"></tbody></table></div></div>
  <div class="card" style="margin-top:10px"><div class="k">Bot health</div><div class="row" id="health"></div></div>
 </div>
 <div class="card"><div class="k">Live activity <span class="mut" style="text-transform:none">(newest first)</span></div><div class="feed" id="feed"></div></div>
</div>
<p class="mut" style="font-size:11px">Auto-refreshes every 10s. Public on-chain data only. Wallet <a id="wl2" target="_blank"></a></p>
</div>
<script>
const $=id=>document.getElementById(id);
const usd=x=>x==null?'—':(x<0?'-$':'$')+Math.abs(x).toFixed(2);
const sgn=x=>x>=0?'g':'r';const pct=x=>x==null?'—':(x>=0?'+':'')+x.toFixed(1)+'%';
const dur=s=>{s=Math.round(s);return s<60?s+'s':Math.floor(s/60)+'m '+(s%60)+'s'};
const short=s=>s?s.slice(0,4)+'…'+s.slice(-4):'';
let chart,series,lines=[],chartMint=null;
function esc(s){return String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
function drawChart(o){
 const el=$('chart');if(!el)return;
 if(!chart||chartMint!==o.mint){el.innerHTML='';chart=LightweightCharts.createChart(el,{layout:{background:{color:'#121821'},textColor:'#8a97a8'},grid:{vertLines:{color:'#1a2330'},horzLines:{color:'#1a2330'}},timeScale:{timeVisible:true,secondsVisible:true},rightPriceScale:{borderColor:'#1f2a36'},localization:{timeFormatter:t=>new Date(t*1000).toLocaleTimeString('en-US',{timeZone:'America/New_York'})+' ET'}});
  series=chart.addCandlestickSeries({upColor:'#22c55e',downColor:'#ef4444',borderVisible:false,wickUpColor:'#22c55e',wickDownColor:'#ef4444',priceFormat:{type:'price',precision:10,minMove:1e-10}});chartMint=o.mint;lines=[];
  new ResizeObserver(()=>chart.applyOptions({width:el.clientWidth})).observe(el);}
 const c=(o.candles||[]).map(x=>({time:x[0],open:x[1],high:x[2],low:x[3],close:x[4]}));series.setData(c);
 lines.forEach(l=>series.removePriceLine(l));lines=[];
 const add=(p,col,t)=>{if(p)lines.push(series.createPriceLine({price:p,color:col,lineWidth:1,lineStyle:2,axisLabelVisible:true,title:t}))};
 add(o.entry_px,'#38bdf8','Entry');add(o.stop_px,'#ef4444','Stop');add(o.tp1_px,'#22c55e','TP1 +20%');add(o.tp2_px,'#16a34a','TP2 +40%');
 if(c.length&&o.buy_ts) series.setMarkers([{time:c.reduce((a,x)=>x.time<=o.buy_ts?x.time:a,c[0].time),position:'belowBar',color:'#38bdf8',shape:'arrowUp',text:'BUY'}]);
}
function render(d){
 const s=d.status, age=(Date.now()/1000-d.updated);
 $('sub').innerHTML=`Updated ${esc(d.updated_et)} · SOL ${usd(d.sol_usd)}`+(age>90?` <span class="r">(data ${Math.round(age)}s old)</span>`:'');
 $('statuspill').innerHTML=s.halted?`<span class="pill pr">HALTED: ${esc(s.halt_reason||'')}</span>`:(!s.engine_ok?'<span class="pill py">ENGINE QUIET</span>':'<span class="pill pg">● TRADING</span>');
 $('total').textContent=usd(d.total_usd);$('totsol').textContent=d.total_sol.toFixed(4)+' SOL';
 $('pnl').innerHTML=`<span class="${sgn(d.pnl_usd)}">${usd(d.pnl_usd)}</span>`;$('pnlsub').innerHTML=`${pct(d.pnl_pct)} vs start ${d.start_sol.toFixed(4)} SOL`;
 $('wal').textContent=d.wallet_sol==null?'—':d.wallet_sol.toFixed(4);$('dep').textContent='In trades: '+d.deployed_sol.toFixed(4)+' SOL';
 $('tc').textContent=d.trades.length+(d.open.length?' + '+d.open.length+' open':'');
 const w=d.trades.filter(t=>t.pnl_sol>0).length;$('wl').textContent=`${w} wins · ${d.trades.length-w} losses`;
 $('wl2').textContent=short(d.wallet);$('wl2').href='https://solscan.io/account/'+d.wallet;
 const oc=$('openc');
 if(!d.open.length){oc.innerHTML='<div class="k">Current trade</div><div class="coin mut" style="font-size:20px;margin:14px 0">No open trade — scanning for setups…</div>';chart=null;chartMint=null}
 else{const o=d.open[0];
  if(chartMint!==o.mint||!$('chart')){oc.innerHTML=`<div class="k">Current trade</div><div class="coin" id="cn"></div><div class="mut" id="cmeta"></div><div class="row" id="ostats"></div><div id="chart"></div><div class="mut" id="cwhy" style="font-size:12px;margin-top:6px"></div>`;chart=null}
  $('cn').innerHTML=`${esc(o.coin)} <span class="${sgn(o.ret_pct||0)}" style="font-size:22px">${pct(o.ret_pct)}</span>`;
  $('cmeta').innerHTML=`${esc(o.name||'')} · <a target="_blank" href="https://pump.fun/coin/${o.mint}">${short(o.mint)} on pump.fun</a> · <a target="_blank" href="https://solscan.io/tx/${o.entry_sig}">buy tx</a> · setup: ${esc(o.setup)}`+(d.open.length>1?` · +${d.open.length-1} more open`:'');
  $('ostats').innerHTML=`<div><div class="k">Entry</div>${o.entry_sol.toFixed(4)} SOL (${usd(o.entry_usd)})</div><div><div class="k">Now worth</div>${o.value_sol==null?'—':o.value_sol.toFixed(4)+' SOL ('+usd(o.value_usd)+')'}</div><div><div class="k">Entry time</div>${esc(o.entry_time)}</div><div><div class="k">Held</div>${dur(Date.now()/1000-o.buy_ts)}</div><div><div class="k">Best / worst</div><span class="g">${pct(o.high_ret)}</span> / <span class="r">${pct(o.low_ret)}</span></div><div><div class="k">Stop</div>${pct(o.stop_pct)}</div>`;
  $('cwhy').textContent='Why: '+(o.why||'');drawChart(o);}
 $('tr').innerHTML=d.trades.map(t=>`<tr><td>${esc(t.sell_time||t.buy_time).replace(':00 ',' ')}</td><td><a target="_blank" href="https://pump.fun/coin/${t.mint}">${esc(t.coin)}</a></td><td>${usd(t.buy_usd)}</td><td>${usd(t.sell_usd)}</td><td class="${sgn(t.pnl_usd)}">${usd(t.pnl_usd)} (${pct(t.pnl_pct)})</td><td>${dur(t.hold_s||0)}</td><td>${t.txs.map(x=>`<a target="_blank" href="https://solscan.io/tx/${x.sig}">${x.side[0]}${x.side=='PARTIAL_SELL'?'½':''}</a>`).join(' ')}</td></tr>`).join('')||'<tr><td colspan=7 class="mut">No closed trades yet today</td></tr>';
 $('health').innerHTML=`<div><div class="k">Mode</div>${s.live?'LIVE':'SIM'}</div><div><div class="k">Last heartbeat</div><span class="${s.engine_ok?'g':'r'}">${esc(s.last_heartbeat_et||'—')}</span></div><div><div class="k">Price feed</div><span class="${s.feed_fresh?'g':'r'}">${s.feed_fresh?'fresh':'STALE'} (${s.feed_age_s==null?'?':Math.round(s.feed_age_s)+'s'})</span></div><div><div class="k">Buys</div>${s.halted?'<span class="r">paused</span>':'<span class="g">allowed</span>'}</div>`;
 $('feed').innerHTML=d.activity.map(e=>{const cls={buy:'kb',sell:'ks',halt:'kh',stale:'kh'}[e.kind]||'';const link=e.sig?` <a target="_blank" href="https://solscan.io/tx/${e.sig}">tx</a>`:'';return `<div class="ev"><span class="t">${esc(e.t)}</span><span class="${cls}">${esc(e.text)}</span>${link}</div>`}).join('');
}
async function tick(){try{const r=await fetch((window.DATA_URL||'data.json')+'?t='+Date.now(),{cache:'no-store'});render(await r.json())}catch(e){$('sub').innerHTML='<span class="r">Connection problem, retrying…</span>'}}
tick();setInterval(tick,10000);
</script></body></html>
