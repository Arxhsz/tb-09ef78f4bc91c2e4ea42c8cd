{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arxhsz/trade-bot-dashboard/schema/desk-export.v1.schema.json",
  "title": "pumpdesk6 desk export v1 (PAPER)",
  "type": "object",
  "required": ["schema", "schema_version", "generated_at_ms", "generated_at_et", "mode", "live_trading_enabled", "params_version", "notice", "feeds", "agents", "books", "grad", "whales", "sniper", "router", "exec", "exit", "opportunities", "opportunity_stats", "performance", "trades", "journal", "validation"],
  "properties": {
    "schema": { "const": "pumpdesk6.desk-export" },
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "generated_at_ms": { "type": "integer", "minimum": 1700000000000 },
    "generated_at_et": { "type": "string" },
    "mode": { "const": "PAPER" },
    "live_trading_enabled": { "const": false },
    "params_version": { "type": "string" },
    "desk_started_ms": { "type": "integer" },
    "notice": { "type": "string" },
    "paused_reason": { "type": ["string", "null"] },
    "feeds": { "type": "object", "required": ["solana_ws", "pumpportal_ws"], "additionalProperties": { "$ref": "#/$defs/feed" } },
    "agents": { "type": "object", "required": ["GRAD", "WHALES", "SNIPER", "ROUTER", "EXEC", "EXIT"], "additionalProperties": false,
      "properties": { "GRAD": { "$ref": "#/$defs/agent" }, "WHALES": { "$ref": "#/$defs/agent" }, "SNIPER": { "$ref": "#/$defs/agent" }, "ROUTER": { "$ref": "#/$defs/agent" }, "EXEC": { "$ref": "#/$defs/agent" }, "EXIT": { "$ref": "#/$defs/agent" } } },
    "books": { "type": "object", "required": ["real", "research"], "additionalProperties": false, "properties": { "real": { "$ref": "#/$defs/book" }, "research": { "$ref": "#/$defs/book" } } },
    "grad": { "type": "object", "required": ["counts", "tracked_mints", "phases", "curves", "graduated", "graduation_events", "discoveries"] },
    "whales": { "type": "object", "required": ["wallets_tracked", "proven_count", "closed_round_trips_observed", "proven", "activity"] },
    "sniper": { "type": "object", "required": ["counts", "recent"], "properties": { "counts": { "type": "object", "required": ["scans", "independent_opportunities", "passed", "vetoed"] } } },
    "router": { "type": "object", "required": ["quotes", "errors", "recent", "cost_model"] },
    "exec": { "type": "object", "required": ["mode", "counts", "risk_limits", "books", "pending_orders", "decisions"], "properties": { "mode": { "const": "PAPER" } } },
    "exit": { "type": "object", "required": ["policies", "primary", "open"] },
    "opportunities": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
    "opportunity_stats": { "type": "object", "required": ["total_independent_opportunities"] },
    "performance": { "type": "object", "required": ["closed_positions_total", "independent_closed_trades", "by_book_primary", "by_exit_policy_research", "by_setup_primary", "by_whale_primary"] },
    "trades": { "type": "array", "items": { "$ref": "#/$defs/trade" } },
    "journal": { "type": "array", "items": { "type": "object", "required": ["t", "agent", "kind", "msg"] } },
    "validation": { "type": "object", "required": ["params_frozen", "target_independent_closed_trades", "independent_closed_trades", "holdout_rule"] },
    "storage": { "type": ["object", "null"] },
    "health": { "type": ["object", "null"] }
  },
  "additionalProperties": false,
  "$defs": {
    "feed": { "type": "object", "properties": { "fresh": { "type": "boolean" }, "age_s": { "type": ["number", "null"] }, "msgs": { "type": "integer" } } },
    "agent": { "type": "object", "required": ["name", "role", "state", "last_activity_ms", "age_s", "fresh", "freshness_limit_s", "summary"],
      "properties": { "state": { "enum": ["starting", "running", "paused", "error"] }, "fresh": { "type": "boolean" }, "last_activity_ms": { "type": ["integer", "null"] }, "age_s": { "type": ["number", "null"] } } },
    "book": { "type": "object", "required": ["name", "label", "mode", "start_sol", "cash_sol", "equity_sol", "realized_sol", "trades", "wins", "losses", "paused_reason", "fees_sol", "equity_curve"],
      "properties": { "mode": { "const": "PAPER" }, "start_sol": { "type": "number", "minimum": 0 }, "equity_sol": { "type": "number" } } },
    "opportunity": { "type": "object", "required": ["id", "t", "mint", "setup", "phase", "whale_confirmed", "vetoes", "disposition", "reason", "books"],
      "properties": { "setup": { "enum": ["A", "B"] }, "disposition": { "enum": ["VETOED", "PASSED_NOT_ORDERED", "ORDER_PENDING", "FILLED", "NO_FILL"] }, "vetoes": { "type": "array", "items": { "type": "string" } } } },
    "trade": { "type": "object", "required": ["id", "book", "policy", "role", "mint", "setup", "entry_t", "exit_t", "size_sol", "pnl_sol", "pnl_pct", "exit_reason"],
      "properties": { "book": { "enum": ["real", "research"] }, "role": { "enum": ["primary", "shadow"] } } }
  }
}
